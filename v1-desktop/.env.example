# E-mail remetente usado no MIME enviado pela Gmail API
EMAIL_REMETENTE=seu_email@gmail.com

# Destinatário(s) dos PDFs; para vários endereços, separe por vírgula
EMAIL_DESTINO=email_destino@gmail.com,outro_destino@gmail.com

# O envio usa Gmail API/OAuth 2.0. Coloque o credentials.json de um cliente
# Desktop App nesta pasta; o token.json será criado após a primeira autorização.

# Número que receberá a notificação via WhatsApp
# Use DDD + número. Exemplo: 11999999999
WHATSAPP_ESCOLAR=11999999999
